<Window x:Class="WinMeters.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMeters Settings" Height="720" Width="900"
        MinHeight="540" MinWidth="720"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT RAIL -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource ThemeCardBgBrush}"
                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,16">
                <TextBlock Text="WinMeters"
                           FontFamily="Segoe UI" FontWeight="SemiBold"
                           FontSize="14" Margin="20,4,20,16"
                           Foreground="{DynamicResource ThemeAccentBrush}"/>
                <RadioButton x:Name="NavHome"       Content="Home"        Tag="Home"
                             GroupName="NavRail" IsChecked="True"
                             Click="NavRail_Click" Style="{StaticResource Kil0bitNavItem}"/>
                <RadioButton x:Name="NavGeneral"    Content="General"     Tag="General"
                             GroupName="NavRail" Click="NavRail_Click"
                             Style="{StaticResource Kil0bitNavItem}"/>
                <RadioButton x:Name="NavMonitoring" Content="Monitoring"  Tag="Monitoring"
                             GroupName="NavRail" Click="NavRail_Click"
                             Style="{StaticResource Kil0bitNavItem}"/>
                <RadioButton x:Name="NavAppearance" Content="Appearance"  Tag="Appearance"
                             GroupName="NavRail" Click="NavRail_Click"
                             Style="{StaticResource Kil0bitNavItem}"/>
                <RadioButton x:Name="NavAbout"      Content="About"       Tag="About"
                             GroupName="NavRail" Click="NavRail_Click"
                             Style="{StaticResource Kil0bitNavItem}"/>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="0" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="32,24">

                <!-- HOME -->
                <StackPanel x:Name="SectionHome">
                    <TextBlock Style="{StaticResource Kil0bitSectionHeader}" Text="Welcome"/>
                    <TextBlock Style="{StaticResource Kil0bitTextSub}"
                               Text="WinMeters is active and tracking your hardware performance with near-zero overhead."
                               TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,20"/>

                    <UniformGrid Columns="2" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Button Click="HomeCard_Click" Tag="General" Width="320" Height="100" Margin="0,0,12,12"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Style="{StaticResource Kil0bitCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Text="&#xE713;"
                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                               VerticalAlignment="Top" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="General" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource Kil0bitTextSub}"
                                                   Text="Lock position, hide in fullscreen, snap to taskbar, refresh rate."
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        <Button Click="HomeCard_Click" Tag="Monitoring" Width="320" Height="100" Margin="0,0,0,12"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Style="{StaticResource Kil0bitCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Text="&#xE9F5;"
                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                               VerticalAlignment="Top" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Monitoring" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource Kil0bitTextSub}"
                                                   Text="Toggle which meters are shown and pick disk / network adapters."
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        <Button Click="HomeCard_Click" Tag="Appearance" Width="320" Height="100" Margin="0,0,12,0"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Style="{StaticResource Kil0bitCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Text="&#xE70F;"
                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                               VerticalAlignment="Top" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Appearance" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource Kil0bitTextSub}"
                                                   Text="Scale, opacity, accent colour, and per-meter colours."
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        <Button Click="HomeCard_Click" Tag="About" Width="320" Height="100"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Style="{StaticResource Kil0bitCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Text="&#xE897;"
                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                               VerticalAlignment="Top" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="About" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource Kil0bitTextSub}"
                                                   Text="Version info and project links."
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </UniformGrid>

                    <Border Style="{StaticResource Kil0bitInfoBar}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE916;"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Performance Note" FontSize="13"/>
                                <TextBlock Style="{StaticResource Kil0bitTextSub}"
                                           Text="Hardware metrics are read through low-level Win32 APIs. CPU usage resumes from the existing AppBar / Taskbar integration."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- GENERAL -->
                <StackPanel x:Name="SectionGeneral" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Kil0bitSectionHeader}" Text="General"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Kil0bitCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE72E;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Lock Position" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Prevent accidental dragging." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToggleLockPosition" Grid.Column="2" Style="{StaticResource Kil0bitToggleSwitch}"
                                          Click="GenericToggle_Click" Tag="LockPosition"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Kil0bitCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE740;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Hide in Fullscreen" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Hide during games / movies." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToggleHideInFullscreen" Grid.Column="2" Style="{StaticResource Kil0bitToggleSwitch}"
                                          Click="GenericToggle_Click" Tag="HideInFullscreen"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Kil0bitCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE90E;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Snap to Taskbar" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Dock to the taskbar area." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToggleSnapToTaskbar" Grid.Column="2" Style="{StaticResource Kil0bitToggleSwitch}"
                                          Click="GenericToggle_Click" Tag="SnapToTaskbar"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Kil0bitCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE840;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Keep on Top" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Stay above other windows." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToggleKeepOnTop" Grid.Column="2" Style="{StaticResource Kil0bitToggleSwitch}"
                                          Click="GenericToggle_Click" Tag="KeepOnTop"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Kil0bitCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE823;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="24-Hour Time" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Display time in 24h format." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToggleTime24H" Grid.Column="2" Style="{StaticResource Kil0bitToggleSwitch}"
                                          Click="GenericToggle_Click" Tag="Time24H"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Kil0bitCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE950;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Combine Logical Cores" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Show one bar per physical core pair." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ToggleCombineLogicalCores" Grid.Column="2" Style="{StaticResource Kil0bitToggleSwitch}"
                                          Click="GenericToggle_Click" Tag="CombineLogicalCores"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Kil0bitCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE916;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Refresh Rate" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Kil0bitTextSub}"
                                               Text="How often the meters update. Per-meter overrides below."
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="ComboRefreshRate" Grid.Column="2"
                                          VerticalAlignment="Center"
                                          SelectionChanged="ComboRefreshRate_SelectionChanged"
                                          Style="{StaticResource Kil0bitComboBox}">
                                    <ComboBoxItem Content="500 ms (High)"   Tag="500"/>
                                    <ComboBoxItem Content="1000 ms (Default)" Tag="1000"/>
                                    <ComboBoxItem Content="2000 ms (Relaxed)"  Tag="2000"/>
                                    <ComboBoxItem Content="5000 ms (Power Saver)" Tag="5000"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource Kil0bitSubHeader}" Text="Per-Meter Rates (ms)" Margin="0,20,0,10"/>
                    <Border Style="{StaticResource Kil0bitCard}">
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="CPU"/>
                                <TextBox x:Name="TxtRateCpu" Style="{StaticResource Kil0bitTextBox}"
                                         TextChanged="RateTextBox_TextChanged" Tag="Cpu"/>
                                <TextBlock x:Name="ErrRateCpu" Style="{StaticResource Kil0bitTextSub}"
                                           Foreground="{DynamicResource ThemeDangerBrush}" Visibility="Collapsed" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="RAM"/>
                                <TextBox x:Name="TxtRateRam" Style="{StaticResource Kil0bitTextBox}"
                                         TextChanged="RateTextBox_TextChanged" Tag="Ram"/>
                                <TextBlock x:Name="ErrRateRam" Style="{StaticResource Kil0bitTextSub}"
                                           Foreground="{DynamicResource ThemeDangerBrush}" Visibility="Collapsed" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Disk"/>
                                <TextBox x:Name="TxtRateDisk" Style="{StaticResource Kil0bitTextBox}"
                                         TextChanged="RateTextBox_TextChanged" Tag="Disk"/>
                                <TextBlock x:Name="ErrRateDisk" Style="{StaticResource Kil0bitTextSub}"
                                           Foreground="{DynamicResource ThemeDangerBrush}" Visibility="Collapsed" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Net"/>
                                <TextBox x:Name="TxtRateNet" Style="{StaticResource Kil0bitTextBox}"
                                         TextChanged="RateTextBox_TextChanged" Tag="Net"/>
                                <TextBlock x:Name="ErrRateNet" Style="{StaticResource Kil0bitTextSub}"
                                           Foreground="{DynamicResource ThemeDangerBrush}" Visibility="Collapsed" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,12,0">
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="CPU Temp"/>
                                <TextBox x:Name="TxtRateCpuTemp" Style="{StaticResource Kil0bitTextBox}"
                                         TextChanged="RateTextBox_TextChanged" Tag="CpuTemp"/>
                                <TextBlock x:Name="ErrRateCpuTemp" Style="{StaticResource Kil0bitTextSub}"
                                           Foreground="{DynamicResource ThemeDangerBrush}" Visibility="Collapsed" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,12,0">
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="GPU Temp"/>
                                <TextBox x:Name="TxtRateGpuTemp" Style="{StaticResource Kil0bitTextBox}"
                                         TextChanged="RateTextBox_TextChanged" Tag="GpuTemp"/>
                                <TextBlock x:Name="ErrRateGpuTemp" Style="{StaticResource Kil0bitTextSub}"
                                           Foreground="{DynamicResource ThemeDangerBrush}" Visibility="Collapsed" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,12,0">
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="VRAM"/>
                                <TextBox x:Name="TxtRateGpuDedicated" Style="{StaticResource Kil0bitTextBox}"
                                         TextChanged="RateTextBox_TextChanged" Tag="GpuDedicated"/>
                                <TextBlock x:Name="ErrRateGpuDedicated" Style="{StaticResource Kil0bitTextSub}"
                                           Foreground="{DynamicResource ThemeDangerBrush}" Visibility="Collapsed" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="SRAM"/>
                                <TextBox x:Name="TxtRateGpuShared" Style="{StaticResource Kil0bitTextBox}"
                                         TextChanged="RateTextBox_TextChanged" Tag="GpuShared"/>
                                <TextBlock x:Name="ErrRateGpuShared" Style="{StaticResource Kil0bitTextSub}"
                                           Foreground="{DynamicResource ThemeDangerBrush}" Visibility="Collapsed" FontSize="10"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- MONITORING -->
                <StackPanel x:Name="SectionMonitoring" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Kil0bitSectionHeader}" Text="Monitoring"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Kil0bitCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Kil0bitSubHeader}" Text="Hardware Telemetry"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="CPU Usage" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowCpu" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowCpu"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="RAM Usage" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowRam" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowRam"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Disk" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowDisk" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowDisk"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Network" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowNet" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowNet"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="VRAM" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowGpuDedicated" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowGpuDedicated"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="SRAM" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowGpuShared" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowGpuShared"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="CPU Temp" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowCpuTemp" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowCpuTemp"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="GPU Temp" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowGpuTemp" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowGpuTemp"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="H/W Load" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowHardwareLoad" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowHardwareLoad"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Time" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ToggleShowTime" Style="{StaticResource Kil0bitToggleSwitch}"
                                                  Click="GenericToggle_Click" Tag="ShowTime"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Kil0bitCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Kil0bitSubHeader}" Text="Hardware Selection"/>
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Network Adapter" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboNetwork" Style="{StaticResource Kil0bitComboBox}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ComboNetwork_SelectionChanged"
                                          Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Disk Instance" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboDisk" Style="{StaticResource Kil0bitComboBox}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ComboDisk_SelectionChanged"
                                          Margin="0,0,0,12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- APPEARANCE -->
                <StackPanel x:Name="SectionAppearance" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Kil0bitSectionHeader}" Text="Appearance"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Kil0bitCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Kil0bitSubHeader}" Text="Layout"/>
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Scale" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Kil0bitTextSub}"
                                               Text="{Binding ElementName=SliderScale, Path=Value, StringFormat=F2}"/>
                                    <Slider x:Name="SliderScale" Minimum="0.5" Maximum="2.0"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Style="{StaticResource Kil0bitSlider}"
                                            ValueChanged="SliderScale_ValueChanged"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Opacity" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Kil0bitTextSub}"
                                               Text="{Binding ElementName=SliderOpacity, Path=Value, StringFormat=F2}"/>
                                    <Slider x:Name="SliderOpacity" Minimum="0" Maximum="1.0"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Style="{StaticResource Kil0bitSlider}"
                                            ValueChanged="SliderOpacity_ValueChanged"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Kil0bitTextSub}"
                                           Text="Tip: opacity is ignored when the bar is docked to the taskbar. Edit the alpha byte of Background instead."
                                           TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Kil0bitCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Kil0bitSubHeader}" Text="Theme Colours"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchAccent"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Accent"/>
                                        <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Toggles, active nav, button accents."/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Pick..." Click="ColorButton_Click" Tag="Accent"
                                            Style="{StaticResource Kil0bitSecondaryButton}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchBackground"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Background"/>
                                        <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Bar fill (alpha controls translucency)."/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Pick..." Click="ColorButton_Click" Tag="Background"
                                            Style="{StaticResource Kil0bitSecondaryButton}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchBorder"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Kil0bitTextHint}" Text="Border"/>
                                        <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Bar outline."/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Pick..." Click="ColorButton_Click" Tag="Border"
                                            Style="{StaticResource Kil0bitSecondaryButton}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource Kil0bitCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Kil0bitSubHeader}" Text="Per-Meter Colours"/>
                                <UniformGrid Columns="2">
                                    <Button Click="ColorButton_Click" Tag="CpuSys" Margin="0,0,4,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchCpuSys"/>
                                            <TextBlock Text="CPU Sys" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="CpuUser" Margin="4,0,0,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchCpuUser"/>
                                            <TextBlock Text="CPU User" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="RamPie" Margin="0,4,4,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchRamPie"/>
                                            <TextBlock Text="RAM Pie" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="RamBorder" Margin="4,4,0,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchRamBorder"/>
                                            <TextBlock Text="RAM Border" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="GpuDedicatedPie" Margin="0,4,4,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchGpuDedicatedPie"/>
                                            <TextBlock Text="VRAM" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="GpuSharedPie" Margin="4,4,0,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchGpuSharedPie"/>
                                            <TextBlock Text="SRAM" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="CpuTemp" Margin="0,4,4,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchCpuTemp"/>
                                            <TextBlock Text="CPU Temp" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="GpuTemp" Margin="4,4,0,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchGpuTemp"/>
                                            <TextBlock Text="GPU Temp" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="DiskRead" Margin="0,4,4,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchDiskRead"/>
                                            <TextBlock Text="Disk Read" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="DiskWrite" Margin="4,4,0,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchDiskWrite"/>
                                            <TextBlock Text="Disk Write" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="NetDown" Margin="0,4,4,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchNetDown"/>
                                            <TextBlock Text="Net Down" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="NetUp" Margin="4,4,0,4"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchNetUp"/>
                                            <TextBlock Text="Net Up" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="TimeText" Margin="0,4,4,0"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchTimeText"/>
                                            <TextBlock Text="Time" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ColorButton_Click" Tag="Separator" Margin="4,4,0,0"
                                            Style="{StaticResource Kil0bitSecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Kil0bitColorSwatch}" x:Name="SwatchSeparator"/>
                                            <TextBlock Text="Separator" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Kil0bitCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Kil0bitSubHeader}" Text="Meter Display Order"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="ListMeterOrder" Height="130" Margin="0,0,8,0"
                                         Background="{DynamicResource ThemeCardBgBrush}"
                                         Foreground="{DynamicResource ThemeTextBrush}"
                                         BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                         DisplayMemberPath="Name"
                                         SelectionChanged="ListMeterOrder_SelectionChanged"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="BtnMoveUp" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets"
                                            Click="BtnMoveUp_Click" Style="{StaticResource Kil0bitSecondaryButton}"
                                            Width="34" Height="34" Margin="0,0,0,4" ToolTip="Move Up"/>
                                    <Button x:Name="BtnMoveDown" Content="&#xE74B;" FontFamily="Segoe MDL2 Assets"
                                            Click="BtnMoveDown_Click" Style="{StaticResource Kil0bitSecondaryButton}"
                                            Width="34" Height="34" ToolTip="Move Down"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ABOUT -->
                <StackPanel x:Name="SectionAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Kil0bitSectionHeader}" Text="About"/>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="WinMeters" FontSize="20"/>
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource Kil0bitTextSub}" Text="v2.4"/>
                        <TextBlock Style="{StaticResource Kil0bitTextSub}"
                                   Text="A lightweight, high-performance system monitoring overlay designed for power users. Built with WPF and GDI+ rendering."
                                   TextWrapping="Wrap" MaxWidth="640" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource Kil0bitHorizontalRule}"/>
                    <TextBlock Style="{StaticResource Kil0bitTextHeading}" Text="Project Links" FontSize="16" Margin="0,8,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Click="HyperlinkButton_Click" Tag="https://github.com/your-repo/winmeters"
                                Content="Repository" Style="{StaticResource Kil0bitSecondaryButton}" Margin="0,0,8,0"/>
                        <Button Click="HyperlinkButton_Click" Tag="https://github.com/your-repo/winmeters/issues"
                                Content="Report Issue" Style="{StaticResource Kil0bitSecondaryButton}"/>
                    </StackPanel>
                    <Border Style="{StaticResource Kil0bitHorizontalRule}" Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Hotkey: Ctrl+Alt+Shift+M" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Kil0bitTextSub}" Text="Right-click the bar for live toggles." Margin="0,2,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{DynamicResource ThemeCardBgBrush}"
                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnQuit" Grid.Column="0" Content="Quit Application"
                        Click="BtnQuit_Click" Style="{StaticResource Kil0bitDangerButton}"
                        HorizontalAlignment="Left"/>
                <Button x:Name="BtnResetAll" Grid.Column="1" Content="Reset All Settings"
                        Click="BtnResetAll_Click"
                        Foreground="#FF6666" Background="Transparent"
                        HorizontalAlignment="Center" Padding="20,8"/>
                <Button x:Name="BtnSave" Grid.Column="2" Content="Save &amp; Close"
                        Click="BtnSave_Click" Style="{StaticResource Kil0bitPrimaryButton}"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
