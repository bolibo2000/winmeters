<Window x:Class="WinMeters.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Settings" Height="580" Width="470" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FocusManager.FocusedElement="{Binding ElementName=SliderOpacity}">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style x:Key="SliderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="RateTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="55"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="RateLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="65"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,4,2"/>
        </Style>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,-2,0,0"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="RateGroupStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4">
                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel Margin="0,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Opacity:" Style="{StaticResource SliderLabelStyle}" Width="45"/>
                        <Slider x:Name="SliderOpacity" Minimum="0" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Style="{StaticResource SliderStyle}" TabIndex="0"/>
                        <TextBlock x:Name="TxtOpacity" Width="35" Margin="4,0" FontSize="10" TextAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="Scale:" Style="{StaticResource SliderLabelStyle}" Width="35"/>
                        <Slider x:Name="SliderScale" Minimum="0.5" Maximum="2.0" Style="{StaticResource SliderStyle}" TabIndex="1"/>
                        <TextBlock x:Name="TxtScale" Width="35" Margin="4,0" FontSize="10" TextAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkTime24H" Content="24-Hour Time" FontSize="10" VerticalAlignment="Center" TabIndex="25"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Refresh Rates -->
                <TextBlock Text="Refresh Rates (ms)" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel Margin="0,2">
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="CPU:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateCpu" Style="{StaticResource RateTextBoxStyle}" TabIndex="2"/>
                        <TextBlock x:Name="ErrRateCpu" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="RAM:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateRam" Style="{StaticResource RateTextBoxStyle}" TabIndex="3"/>
                        <TextBlock x:Name="ErrRateRam" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="Disk:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateDisk" Style="{StaticResource RateTextBoxStyle}" TabIndex="4"/>
                        <TextBlock x:Name="ErrRateDisk" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="Net:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateNet" Style="{StaticResource RateTextBoxStyle}" TabIndex="5"/>
                        <TextBlock x:Name="ErrRateNet" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="CPU Temp:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateCpuTemp" Style="{StaticResource RateTextBoxStyle}" TabIndex="15"/>
                        <TextBlock x:Name="ErrRateCpuTemp" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="GPU Temp:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateGpuTemp" Style="{StaticResource RateTextBoxStyle}" TabIndex="16"/>
                        <TextBlock x:Name="ErrRateGpuTemp" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="VRAM:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateGpuDedicated" Style="{StaticResource RateTextBoxStyle}" TabIndex="19"/>
                        <TextBlock x:Name="ErrRateGpuDedicated" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="SRAM:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateGpuShared" Style="{StaticResource RateTextBoxStyle}" TabIndex="20"/>
                        <TextBlock x:Name="ErrRateGpuShared" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Colors -->
                <TextBlock Text="Colors" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel x:Name="ColorsPanel" Orientation="Horizontal" ItemHeight="28" ItemWidth="200"/>

                <!-- Visibility -->
                <TextBlock Text="Visibility" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel Margin="0,2">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkCpu" Content="_CPU" Style="{StaticResource CheckBoxStyle}" TabIndex="6"/>
                        <CheckBox x:Name="ChkRam" Content="_RAM" Style="{StaticResource CheckBoxStyle}" TabIndex="7"/>
                        <CheckBox x:Name="ChkGpuDedicated" Content="_VRAM" Style="{StaticResource CheckBoxStyle}" TabIndex="22"/>
                        <CheckBox x:Name="ChkGpuShared" Content="_SRAM" Style="{StaticResource CheckBoxStyle}" TabIndex="23"/>
                        <CheckBox x:Name="ChkDisk" Content="_Disk" Style="{StaticResource CheckBoxStyle}" TabIndex="8"/>
                        <CheckBox x:Name="ChkNet" Content="_Net" Style="{StaticResource CheckBoxStyle}" TabIndex="9"/>
                        <CheckBox x:Name="ChkTime" Content="_Time" Style="{StaticResource CheckBoxStyle}" TabIndex="24"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkCombineCpu" Content="Combine _Logical Cores" Style="{StaticResource CheckBoxStyle}" TabIndex="10"/>
                        <CheckBox x:Name="ChkCpuTemp" Content="CPU _Temp" Style="{StaticResource CheckBoxStyle}" TabIndex="17"/>
                        <CheckBox x:Name="ChkGpuTemp" Content="_GPU Temp" Style="{StaticResource CheckBoxStyle}" TabIndex="18"/>
                        <CheckBox x:Name="ChkHardwareLoad" Content="H/W _Load" Style="{StaticResource CheckBoxStyle}" TabIndex="21"/>
                        <CheckBox x:Name="ChkEnableHardwareMonitor" Content="Enable _Hardware Monitor" Style="{StaticResource CheckBoxStyle}" TabIndex="26"/>

                    </StackPanel>
                </WrapPanel>

                <!-- Disk -->
                <TextBlock Text="Disk" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Drive R/W:" FontSize="10" VerticalAlignment="Center" Width="65" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ComboDisk" Style="{StaticResource ComboBoxStyle}" TabIndex="11"/>
                </StackPanel>

                <!-- Network -->
                <TextBlock Text="Network" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Interface:" FontSize="10" VerticalAlignment="Center" Width="65" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ComboNetwork" Width="160" Style="{StaticResource ComboBoxStyle}" TabIndex="12"/>
                </StackPanel>

                <!-- Meter Display Order -->
                <TextBlock Text="Meter Display Order" Style="{StaticResource SectionHeaderStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="ListMeterOrder" Height="100" Margin="0,0,4,0" DisplayMemberPath="Name"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="BtnMoveUp" Content="↑" Margin="2" Width="40" Click="BtnMoveUp_Click"/>
                        <Button x:Name="BtnMoveDown" Content="↓" Margin="2" Width="40" Click="BtnMoveDown_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="90" Margin="6" Click="BtnOk_Click" IsDefault="True" TabIndex="13">_OK</Button>
            <Button Width="90" Margin="6" Click="BtnCancel_Click" IsCancel="True" TabIndex="14">_Cancel</Button>
        </StackPanel>
    </Grid>
</Window>