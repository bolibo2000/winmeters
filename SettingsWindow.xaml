<Window x:Class="WinMeters.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:WinMeters.Controls"
        Title="WinMeters Settings" Height="720" Width="900"
        MinHeight="540" MinWidth="900"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Auto + MinWidth=0 so the left rail's column tracks the
                 LeftRailBorder's animated Width (200 expanded / 48 collapsed).
                 MinWidth=0 stops the column from being held open by the
                 text labels inside the radio buttons when the rail is
                 collapsed. -->
            <ColumnDefinition Width="Auto" MinWidth="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT RAIL (collapsible). The LeftRailBorder Width is animated by
             SettingsWindow.xaml.cs BtnToggleRail_Click between 200 (expanded)
             and 48 (collapsed); the outer column is Width=Auto MinWidth=0 so
             the column tracks the Border. When collapsed, the 5 nav text
             labels and the WinMeters title are Visibility=Collapsed from
             code-behind so only the 24px Segoe MDL2 Assets icons remain. -->
        <Border x:Name="LeftRailBorder" Grid.Row="0" Grid.Column="0" Width="200"
                Background="{DynamicResource ThemeCardBgBrush}"
                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Search row (always docked at top, above the
                     hamburger). Visible only when the rail is
                     expanded (the collapsed 48px rail has no room
                     for an input). The Segoe MDL2 Assets search
                     glyph (0xE721) is a static prefix; the
                     placeholder TextBlock fades in/out via the
                     TxtSearch TextChanged handler. -->
                <Grid x:Name="NavSearchRow" DockPanel.Dock="Top" Margin="12,16,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="TxtSearch"
                                 Style="{StaticResource WinMetersTextBox}"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock x:Name="TxtSearchPlaceholder" Text="Search sections..."
                                   IsHitTestVisible="False" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Opacity="0.5"
                                   Foreground="{DynamicResource ThemeMutedTextBrush}"/>
                    </Grid>
                </Grid>
                <!-- Hamburger + title row (always docked at top). Hamburger
                     ToggleButton drives the collapse / expand animation;
                     RailTitle TextBlock collapses its Visibility on the
                     same event so it disappears in lock-step. -->
                <Grid DockPanel.Dock="Top" Margin="12,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="BtnToggleRail" Click="BtnToggleRail_Click"
                                  ToolTip="Collapse / expand navigation"
                                  Style="{StaticResource WinMetersHamburgerButton}">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </ToggleButton>
                    <TextBlock x:Name="RailTitle" Grid.Column="1"
                               Text="WinMeters"
                               FontFamily="Segoe UI" FontWeight="SemiBold"
                               FontSize="14" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeAccentBrush}"/>
                </Grid>
                <!-- Nav items (fill remaining dock space). Each item is a
                     DockPanel with a fixed-width 24px Segoe MDL2 Assets
                     icon on the left + the label filling the rest. Icon
                     glyphs mirror the kil0bit NavigationView symbols:
                     Home=E80F, General=E713, Monitoring=E9F5,
                     Appearance=E70F, About=E897. -->
                <StackPanel x:Name="NavItemsPanel" Margin="0,4,0,12">
                    <RadioButton x:Name="NavHome" Tag="Home"
                                 GroupName="NavRail" IsChecked="True"
                                 Click="NavRail_Click" Style="{StaticResource WinMetersNavItem}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE80F;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Width="24" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavHomeText" Text="Home"
                                       VerticalAlignment="Center" Margin="4,0,8,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGeneral" Tag="General"
                                 GroupName="NavRail"
                                 Click="NavRail_Click"
                                 Style="{StaticResource WinMetersNavItem}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Width="24" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavGeneralText" Text="General"
                                       VerticalAlignment="Center" Margin="4,0,8,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMonitoring" Tag="Monitoring"
                                 GroupName="NavRail"
                                 Click="NavRail_Click"
                                 Style="{StaticResource WinMetersNavItem}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE9F5;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Width="24" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavMonitoringText" Text="Monitoring"
                                       VerticalAlignment="Center" Margin="4,0,8,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAppearance" Tag="Appearance"
                                 GroupName="NavRail"
                                 Click="NavRail_Click"
                                 Style="{StaticResource WinMetersNavItem}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE70F;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Width="24" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavAppearanceText" Text="Appearance"
                                       VerticalAlignment="Center" Margin="4,0,8,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Tag="About"
                                 GroupName="NavRail"
                                 Click="NavRail_Click"
                                 Style="{StaticResource WinMetersNavItem}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE897;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Width="24" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavAboutText" Text="About"
                                       VerticalAlignment="Center" Margin="4,0,8,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="0" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="32,24">

                <!-- HOME -->
                <StackPanel x:Name="SectionHome">
                    <TextBlock Style="{StaticResource WinMetersSectionHeader}" Text="Welcome"/>
                    <TextBlock Style="{StaticResource WinMetersTextSub}"
                               Text="WinMeters is active and tracking your hardware performance with near-zero overhead."
                               TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,20"/>

                    <UniformGrid Columns="2" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Button Click="HomeCard_Click" Tag="General" Width="320" Height="100" Margin="0,0,12,12"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Style="{StaticResource WinMetersCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Text="&#xE713;"
                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                               VerticalAlignment="Top" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="General" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource WinMetersTextSub}"
                                                   Text="Lock position, hide in fullscreen, snap to taskbar, refresh rate."
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        <Button Click="HomeCard_Click" Tag="Monitoring" Width="320" Height="100" Margin="0,0,0,12"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Style="{StaticResource WinMetersCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Text="&#xE9F5;"
                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                               VerticalAlignment="Top" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Monitoring" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource WinMetersTextSub}"
                                                   Text="Per-meter show / max-value / refresh-rate / colour cards."
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        <Button Click="HomeCard_Click" Tag="Appearance" Width="320" Height="100" Margin="0,0,12,0"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Style="{StaticResource WinMetersCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Text="&#xE70F;"
                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                               VerticalAlignment="Top" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Appearance" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource WinMetersTextSub}"
                                                   Text="Scale, opacity, theme accent, background, border."
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        <Button Click="HomeCard_Click" Tag="About" Width="320" Height="100"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Style="{StaticResource WinMetersCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" Text="&#xE897;"
                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                               VerticalAlignment="Top" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="About" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource WinMetersTextSub}"
                                                   Text="Version info and project links."
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </UniformGrid>

                    <Border Style="{StaticResource WinMetersInfoBar}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE916;"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Performance Note" FontSize="13"/>
                                <TextBlock Style="{StaticResource WinMetersTextSub}"
                                           Text="Hardware metrics are read through low-level Win32 APIs. CPU usage resumes from the existing AppBar / Taskbar integration."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- GENERAL -->
                <StackPanel x:Name="SectionGeneral" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource WinMetersSectionHeader}" Text="General"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource WinMetersCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE72E;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Lock Position" FontSize="14"/>
                                    <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Prevent accidental dragging." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource WinMetersToggleSwitch}" Tag="LockPosition" Click="GenericToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource WinMetersCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE740;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Hide in Fullscreen" FontSize="14"/>
                                    <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Hide during games / movies." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource WinMetersToggleSwitch}" Tag="HideInFullscreen" Click="GenericToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource WinMetersCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE90E;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Snap to Taskbar" FontSize="14"/>
                                    <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Dock to the taskbar area." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource WinMetersToggleSwitch}" Tag="SnapToTaskbar" Click="GenericToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource WinMetersCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE840;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Keep on Top" FontSize="14"/>
                                    <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Stay above other windows." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource WinMetersToggleSwitch}" Tag="KeepOnTop" Click="GenericToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource WinMetersCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE823;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="24-Hour Time" FontSize="14"/>
                                    <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Display time in 24h format." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource WinMetersToggleSwitch}" Tag="Time24H" Click="GenericToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource WinMetersCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE950;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Combine Logical Cores" FontSize="14"/>
                                    <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Show one bar per physical core pair." TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource WinMetersToggleSwitch}" Tag="CombineLogicalCores" Click="GenericToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource WinMetersCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE916;"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Refresh Rate" FontSize="14"/>
                                    <TextBlock Style="{StaticResource WinMetersTextSub}"
                                               Text="How often the meters update. Per-meter overrides are on the Monitoring page."
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="ComboRefreshRate" Grid.Column="2"
                                          VerticalAlignment="Center"
                                          SelectionChanged="ComboRefreshRate_SelectionChanged"
                                          Style="{StaticResource WinMetersComboBox}">
                                    <ComboBoxItem Content="500 ms (High)"   Tag="500"/>
                                    <ComboBoxItem Content="1000 ms (Default)" Tag="1000"/>
                                    <ComboBoxItem Content="2000 ms (Relaxed)"  Tag="2000"/>
                                    <ComboBoxItem Content="5000 ms (Power Saver)" Tag="5000"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource WinMetersSubHeader}" Text="Hardware Selection" Margin="0,20,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource WinMetersCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource WinMetersTextHint}" Text="Network Adapter" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboNetwork" Style="{StaticResource WinMetersComboBox}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ComboNetwork_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource WinMetersCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource WinMetersTextHint}" Text="Disk Instance" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboDisk" Style="{StaticResource WinMetersComboBox}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ComboDisk_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource WinMetersSubHeader}" Text="Sub-Meter Toggles" Margin="0,20,0,10"/>
                    <Border Style="{StaticResource WinMetersCard}">
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource WinMetersTextHint}" Text="CPU Temp" Margin="0,0,0,4"/>
                                <CheckBox Style="{StaticResource WinMetersToggleSwitch}" Tag="ShowCpuTemp" Click="GenericToggle_Click"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource WinMetersTextHint}" Text="GPU Temp" Margin="0,0,0,4"/>
                                <CheckBox Style="{StaticResource WinMetersToggleSwitch}" Tag="ShowGpuTemp" Click="GenericToggle_Click"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource WinMetersTextHint}" Text="H/W Load" Margin="0,0,0,4"/>
                                <CheckBox Style="{StaticResource WinMetersToggleSwitch}" Tag="ShowHardwareLoad" Click="GenericToggle_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource WinMetersTextHint}" Text="Time" Margin="0,0,0,4"/>
                                <CheckBox Style="{StaticResource WinMetersToggleSwitch}" Tag="ShowTime" Click="GenericToggle_Click"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- MONITORING: 5 MetricCards -->
                <StackPanel x:Name="SectionMonitoring" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource WinMetersSectionHeader}" Text="Monitoring"/>
                    <TextBlock Style="{StaticResource WinMetersTextSub}"
                               Text="Each meter keeps its visibility toggle, max-value, refresh rate, and section colour in one card. Adding or reordering a meter is a one-line edit in code-behind."
                               TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,16"/>

                    <StackPanel x:Name="MetricsPanel">
                        <ctrl:MetricCard x:Name="CardCpu"
                                         Title="CPU" Subtitle="Combined system + user core usage."
                                         Glyph="&#xE950;" MetricKey="Cpu"/>
                        <ctrl:MetricCard x:Name="CardRam"
                                         Title="Memory" Subtitle="Physical RAM usage."
                                         Glyph="&#xE7F4;" MetricKey="Ram"/>
                        <ctrl:MetricCard x:Name="CardGpu"
                                         Title="GPU" Subtitle="VRAM + SRAM pie charts."
                                         Glyph="&#xE9A3;" MetricKey="Gpu"/>
                        <ctrl:MetricCard x:Name="CardNet"
                                         Title="Network" Subtitle="Adapter down/up throughput in KB/s."
                                         Glyph="&#xE839;" MetricKey="Net"/>
                        <ctrl:MetricCard x:Name="CardDisk"
                                         Title="Disk" Subtitle="Disk instance read/write throughput."
                                         Glyph="&#xEDA2;" MetricKey="Disk"/>
                    </StackPanel>

                    <Border Style="{StaticResource WinMetersInfoBar}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE71D;"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Tip" FontSize="13"/>
                                <TextBlock Style="{StaticResource WinMetersTextSub}"
                                           Text="Show must be on for a meter to render in the bar. Max-value scales the meter (Net/Disk default to 0 so the bar adapts to your hardware)."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- APPEARANCE -->
                <StackPanel x:Name="SectionAppearance" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource WinMetersSectionHeader}" Text="Appearance"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource WinMetersCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource WinMetersSubHeader}" Text="Layout"/>
                                <TextBlock Style="{StaticResource WinMetersTextHint}" Text="Scale" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource WinMetersTextSub}"
                                               Text="{Binding ElementName=SliderScale, Path=Value, StringFormat=F2}"/>
                                    <Slider x:Name="SliderScale" Minimum="0.5" Maximum="2.0"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Style="{StaticResource WinMetersSlider}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource WinMetersTextHint}" Text="Opacity" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource WinMetersTextSub}"
                                               Text="{Binding ElementName=SliderOpacity, Path=Value, StringFormat=F2}"/>
                                    <Slider x:Name="SliderOpacity" Minimum="0" Maximum="1.0"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Style="{StaticResource WinMetersSlider}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource WinMetersTextSub}"
                                           Text="Tip: opacity is ignored when the bar is docked to the taskbar. Edit the alpha byte of Background instead."
                                           TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource WinMetersCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource WinMetersSubHeader}" Text="Theme Tokens"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource WinMetersColorSwatch}" x:Name="SwatchAccent"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource WinMetersTextHint}" Text="Accent"/>
                                        <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Toggles, active nav, button accents."/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Pick..." Click="ColorButton_Click" Tag="Accent"
                                            Style="{StaticResource WinMetersSecondaryButton}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource WinMetersColorSwatch}" x:Name="SwatchBackground"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource WinMetersTextHint}" Text="Background"/>
                                        <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Bar fill (alpha controls translucency)."/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Pick..." Click="ColorButton_Click" Tag="Background"
                                            Style="{StaticResource WinMetersSecondaryButton}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource WinMetersColorSwatch}" x:Name="SwatchBorder"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource WinMetersTextHint}" Text="Border"/>
                                        <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Bar outline."/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Pick..." Click="ColorButton_Click" Tag="Border"
                                            Style="{StaticResource WinMetersSecondaryButton}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource WinMetersCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource WinMetersSubHeader}" Text="Meter Display Order"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="ListMeterOrder" Height="130" Margin="0,0,8,0"
                                         Background="{DynamicResource ThemeCardBgBrush}"
                                         Foreground="{DynamicResource ThemeTextBrush}"
                                         BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                         DisplayMemberPath="Name"
                                         SelectionChanged="ListMeterOrder_SelectionChanged"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="BtnMoveUp" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets"
                                            Click="BtnMoveUp_Click" Style="{StaticResource WinMetersSecondaryButton}"
                                            Width="34" Height="34" Margin="0,0,0,4" ToolTip="Move Up"/>
                                    <Button x:Name="BtnMoveDown" Content="&#xE74B;" FontFamily="Segoe MDL2 Assets"
                                            Click="BtnMoveDown_Click" Style="{StaticResource WinMetersSecondaryButton}"
                                            Width="34" Height="34" ToolTip="Move Down"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ABOUT -->
                <StackPanel x:Name="SectionAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource WinMetersSectionHeader}" Text="About"/>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="WinMeters" FontSize="20"/>
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource WinMetersTextSub}" Text="v2.4"/>
                        <TextBlock Style="{StaticResource WinMetersTextSub}"
                                   Text="A lightweight, high-performance system monitoring overlay designed for power users."
                                   TextWrapping="Wrap" MaxWidth="640" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource WinMetersHorizontalRule}"/>
                    <TextBlock Style="{StaticResource WinMetersTextHeading}" Text="Project Links" FontSize="16" Margin="0,8,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Click="HyperlinkButton_Click" Tag="https://github.com/your-repo/winmeters"
                                Content="Repository" Style="{StaticResource WinMetersSecondaryButton}" Margin="0,0,8,0"/>
                        <Button Click="HyperlinkButton_Click" Tag="https://github.com/your-repo/winmeters/issues"
                                Content="Report Issue" Style="{StaticResource WinMetersSecondaryButton}"/>
                    </StackPanel>
                    <Border Style="{StaticResource WinMetersHorizontalRule}" Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Hotkey: Ctrl+Alt+Shift+M" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource WinMetersTextSub}" Text="Right-click the bar for live toggles." Margin="0,2,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{DynamicResource ThemeCardBgBrush}"
                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnQuit" Grid.Column="0" Content="Quit Application"
                        Click="BtnQuit_Click" Style="{StaticResource WinMetersDangerButton}"
                        HorizontalAlignment="Left"/>
                <Button x:Name="BtnResetAll" Grid.Column="1" Content="Reset All Settings"
                        Click="BtnResetAll_Click"
                        Foreground="#FF6666" Background="Transparent"
                        HorizontalAlignment="Center" Padding="20,8"/>
                <Button x:Name="BtnSave" Grid.Column="2" Content="Save &amp; Close"
                        Click="BtnSave_Click" Style="{StaticResource WinMetersPrimaryButton}"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- NAV FLYOUT (click-triggered, only visible when the rail is
             collapsed). The Popup is a child of the Window's root Grid
             but doesn't participate in layout (it floats above the
             content). Content is built dynamically from NavItemMetadata
             in code-behind (ShowNavFlyout), so the (name, description)
             tuples live in exactly one place. PlacementTarget is set
             to the clicked RadioButton on each show so the flyout
             anchors at the icon's Y coordinate. -->
        <Popup x:Name="NavFlyout"
               Placement="Right"
               StaysOpen="False"
               AllowsTransparency="True"
               HorizontalOffset="8">
            <Border Style="{StaticResource WinMetersCard}" Padding="12,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.3" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="FlyoutTitle" Text="" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="FlyoutDescription" Text="" Opacity="0.7" FontSize="11" MaxWidth="200" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
