<Window x:Class="WinMeters.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMeters Settings" Height="580" Width="540" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FocusManager.FocusedElement="{Binding ElementName=SliderOpacity}">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
            <!--
                Defensive Foreground setter: the WPF default TextBlock
                style doesn't pin Foreground (so the section headers
                currently inherit white from the Window via the WPF
                property-inheritance chain), but a future WPF theme
                change could break that. ThemeTextBrush pins the value
                to the theme so a recolour propagates here. See the
                CheckBoxStyle comment above for the full precedence
                explanation.
            -->
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        </Style>
        <Style x:Key="SliderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Defensive Foreground; see the SectionHeaderStyle comment. -->
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        </Style>
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="RateTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="55"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
            <!--
                WPF's default TextBox style pins Foreground to
                SystemColors.ControlTextBrushKey (same WPF-default-style
                override that hits the CheckBox labels and the ComboBox
                text; see the CheckBoxStyle comment above for the full
                precedence-chain explanation). Setting Foreground here
                to ThemeTextBrush forces the typed rate values to render
                white on the dark chrome.
            -->
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        </Style>
        <Style x:Key="RateLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="65"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,4,2"/>
            <!-- Defensive Foreground; see the SectionHeaderStyle comment. -->
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        </Style>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,-2,0,0"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="120"/>
            <!--
                WPF's default ComboBox style pins Foreground to
                SystemColors.ControlTextBrushKey (same WPF-default-style
                override that hits the CheckBox labels; see the
                CheckBoxStyle comment above for the full precedence-
                chain explanation). The selected item text and the
                dropdown popup items both render through this
                Foreground, so a missing setter means the disk-drive
                name + the network-interface name would paint black on
                the dark chrome. ThemeTextBrush forces them to white.
            -->
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        </Style>
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Margin" Value="4"/>
            <!--
                Window.Foreground is set to ThemeTextBrush (white) in the
                ctor, but WPF's default CheckBox style (Aero2) overrides
                that with its own Foreground setter pinned to
                SystemColors.ControlTextBrushKey — a system colour that
                evaluates to black on systems where WPF hasn't picked up
                the dark OS theme. That theme-style setter sits at
                precedence level 6, which beats the inherited
                Window.Foreground at level 7, so the inheritance gets
                silently overridden and the label paints black. Setting
                Foreground here on the local style is a Style setter at
                level 4, which beats the default style at level 6 and
                forces the CheckBox's Foreground to ThemeTextBrush. The
                ContentPresenter inside the CheckBox's template then
                inherits the white Foreground via property inheritance
                (the default ContentPresenter style doesn't set
                Foreground, so it falls through to the inherited value).
                ThemeTextBrush (rather than the literal "White") keeps
                the value tied to the theme so a future recolour of
                ThemeTextBrush propagates here.
            -->
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        </Style>
        <Style x:Key="RateGroupStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4">
                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel Margin="0,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Opacity:" Style="{StaticResource SliderLabelStyle}" Width="45"/>                                                <Slider x:Name="SliderOpacity" Minimum="0" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Style="{StaticResource SliderStyle}" TabIndex="0"/>
                        <TextBlock x:Name="TxtOpacity" Width="44" Margin="4,0" FontSize="10" TextAlignment="Left" Text="100%"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="Scale:" Style="{StaticResource SliderLabelStyle}" Width="35"/>                                                <Slider x:Name="SliderScale" Minimum="0.5" Maximum="2.0" Style="{StaticResource SliderStyle}" TabIndex="1"/>
                        <TextBlock x:Name="TxtScale" Width="44" Margin="4,0" FontSize="10" TextAlignment="Left" Text="1.0×"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <!-- Explicit Foreground because ChkTime24H has no Style
                             reference (the other 15 CheckBoxes in this window
                             pick up the white label via the local CheckBoxStyle's
                             Foreground setter, but ChkTime24H opts out of that
                             style to keep its slightly larger FontSize=10). -->
                        <CheckBox x:Name="ChkTime24H" Content="24-Hour Time" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextBrush}" TabIndex="25"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Refresh Rates -->
                <TextBlock Text="Refresh Rates (ms)" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel Margin="0,2">
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="CPU:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateCpu" Style="{StaticResource RateTextBoxStyle}" TabIndex="2"/>
                        <TextBlock x:Name="ErrRateCpu" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="RAM:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateRam" Style="{StaticResource RateTextBoxStyle}" TabIndex="3"/>
                        <TextBlock x:Name="ErrRateRam" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="Disk:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateDisk" Style="{StaticResource RateTextBoxStyle}" TabIndex="4"/>
                        <TextBlock x:Name="ErrRateDisk" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="Net:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateNet" Style="{StaticResource RateTextBoxStyle}" TabIndex="5"/>
                        <TextBlock x:Name="ErrRateNet" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="CPU Temp:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateCpuTemp" Style="{StaticResource RateTextBoxStyle}" TabIndex="15"/>
                        <TextBlock x:Name="ErrRateCpuTemp" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="GPU Temp:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateGpuTemp" Style="{StaticResource RateTextBoxStyle}" TabIndex="16"/>
                        <TextBlock x:Name="ErrRateGpuTemp" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="VRAM:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateGpuDedicated" Style="{StaticResource RateTextBoxStyle}" TabIndex="19"/>
                        <TextBlock x:Name="ErrRateGpuDedicated" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource RateGroupStyle}">
                        <TextBlock Text="SRAM:" Style="{StaticResource RateLabelStyle}"/>
                        <TextBox x:Name="TxtRateGpuShared" Style="{StaticResource RateTextBoxStyle}" TabIndex="20"/>
                        <TextBlock x:Name="ErrRateGpuShared" Style="{StaticResource ErrorTextStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Colors -->
                <TextBlock Text="Colors" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel x:Name="ColorsPanel" Orientation="Horizontal" ItemHeight="28" ItemWidth="200"/>

                <!-- Visibility -->
                <TextBlock Text="Visibility" Style="{StaticResource SectionHeaderStyle}"/>
                <WrapPanel Margin="0,2">
                    <!-- Access behavior toggles (Lock Position / Hide in Fullscreen /
                         Snap to Taskbar / Keep on Top). These don't gate any meter's
                         visibility; they gate how the bar BEHAVES in the desktop
                         and shell (DragMove disabled by LockPosition, AppBarService
                         driven by HideInFullscreen+SnapToTaskbar, WPF Topmost +
                         EnforceZOrder timer driven by KeepOnTop). Drawn first in
                         the Visibility section so the user lands on behavior
                         settings before the meter on/off matrix below. TabIndex
                         28-31 places them after every other keyboard-focusable
                         control so the tab cycle doesn't accidentally land on a
                         destructive Reset before the user has explored the
                         visibility choices. -->
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkLockPosition"      Content="_Lock Position"    Style="{StaticResource CheckBoxStyle}" TabIndex="28"/>
                        <CheckBox x:Name="ChkHideInFullscreen"  Content="Hide in _Fullscreen" Style="{StaticResource CheckBoxStyle}" TabIndex="29"/>
                        <CheckBox x:Name="ChkSnapToTaskbar"     Content="_Snap to Taskbar"  Style="{StaticResource CheckBoxStyle}" TabIndex="30"/>
                        <CheckBox x:Name="ChkKeepOnTop"         Content="_Keep on Top"      Style="{StaticResource CheckBoxStyle}" TabIndex="31"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkCpu" Content="_CPU" Style="{StaticResource CheckBoxStyle}" TabIndex="6"/>
                        <CheckBox x:Name="ChkRam" Content="_RAM" Style="{StaticResource CheckBoxStyle}" TabIndex="7"/>
                        <CheckBox x:Name="ChkGpuDedicated" Content="_VRAM" Style="{StaticResource CheckBoxStyle}" TabIndex="22"/>
                        <CheckBox x:Name="ChkGpuShared" Content="_SRAM" Style="{StaticResource CheckBoxStyle}" TabIndex="23"/>
                        <CheckBox x:Name="ChkDisk" Content="_Disk" Style="{StaticResource CheckBoxStyle}" TabIndex="8"/>
                        <CheckBox x:Name="ChkNet" Content="_Net" Style="{StaticResource CheckBoxStyle}" TabIndex="9"/>
                        <CheckBox x:Name="ChkTime" Content="_Time" Style="{StaticResource CheckBoxStyle}" TabIndex="24"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkCombineCpu" Content="Combine _Logical Cores" Style="{StaticResource CheckBoxStyle}" TabIndex="10"/>
                        <CheckBox x:Name="ChkCpuTemp" Content="CPU _Temp" Style="{StaticResource CheckBoxStyle}" TabIndex="17"/>
                        <CheckBox x:Name="ChkGpuTemp" Content="_GPU Temp" Style="{StaticResource CheckBoxStyle}" TabIndex="18"/>
                        <CheckBox x:Name="ChkHardwareLoad" Content="H/W _Load" Style="{StaticResource CheckBoxStyle}" TabIndex="21"/>
                        <CheckBox x:Name="ChkEnableHardwareMonitor" Content="Enable _Hardware Monitor" Style="{StaticResource CheckBoxStyle}" TabIndex="26"/>

                    </StackPanel>
                </WrapPanel>

                <!-- Disk -->
                <TextBlock Text="Disk" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <!-- Explicit Foreground because the TextBlock has no
                         Style reference (the other section header + rate
                         label TextBlocks inherit white from the local
                         SectionHeaderStyle / RateLabelStyle / SliderLabelStyle
                         via the WPF property-inheritance chain, but those
                         styles also lack a Foreground setter, so they only
                         get white because WPF's default TextBlock style
                         doesn't override the inherited value either. This
                         TextBlock is set explicitly to be defensive in
                         case the WPF default style ever changes). -->
                    <TextBlock Text="Drive R/W:" FontSize="10" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Width="65" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ComboDisk" Style="{StaticResource ComboBoxStyle}" TabIndex="11"/>
                </StackPanel>

                <!-- Network -->
                <TextBlock Text="Network" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <!-- Explicit Foreground; see the Drive R/W: TextBlock
                         comment above for the rationale. -->
                    <TextBlock Text="Interface:" FontSize="10" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Width="65" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ComboNetwork" Width="160" Style="{StaticResource ComboBoxStyle}" TabIndex="12"/>
                </StackPanel>

                <!-- Meter Display Order -->
                <TextBlock Text="Meter Display Order" Style="{StaticResource SectionHeaderStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="ListMeterOrder" Height="100" Margin="0,0,4,0" DisplayMemberPath="Name"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Explicit Foreground on the 2 meter-order arrow
                             buttons; same WPF-default-style override as the
                             3 footer buttons above. The Unicode arrows
                             (U+2191 / U+2193) would otherwise render black
                             on the dark chrome. -->
                        <Button x:Name="BtnMoveUp" Content="↑" Margin="2" Width="40" Foreground="{DynamicResource ThemeTextBrush}" Click="BtnMoveUp_Click"/>
                        <Button x:Name="BtnMoveDown" Content="↓" Margin="2" Width="40" Foreground="{DynamicResource ThemeTextBrush}" Click="BtnMoveDown_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <!-- Explicit Foreground on the 3 footer buttons because they
                 have no Style reference; WPF's default Button style pins
                 Foreground to SystemColors.ControlTextBrushKey (same
                 WPF-default-style override that hits the CheckBox
                 labels; see the CheckBoxStyle comment above for the
                 full precedence-chain explanation). The button label
                 text would otherwise paint black on the dark chrome. -->
            <Button x:Name="BtnReset" Content="_Reset to defaults" Width="100" Margin="6" Foreground="{DynamicResource ThemeTextBrush}" Click="BtnReset_Click" TabIndex="27"/>
            <Button Width="90" Margin="6" Foreground="{DynamicResource ThemeTextBrush}" Click="BtnOk_Click" IsDefault="True" TabIndex="13">_OK</Button>
            <Button Width="90" Margin="6" Foreground="{DynamicResource ThemeTextBrush}" Click="BtnCancel_Click" IsCancel="True" TabIndex="14">_Cancel</Button>
        </StackPanel>
    </Grid>
</Window>