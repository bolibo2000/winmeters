<Window x:Class="WinMeters.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMeters Settings" Height="580" Width="540" WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/winmeters.png"
        ResizeMode="NoResize" FocusManager.FocusedElement="{Binding ElementName=SliderOpacity}">
    <Window.Resources>
        <!--
            All per-window shims (SectionHeaderStyle / SliderLabelStyle /
            SliderStyle / RateTextBoxStyle / RateLabelStyle / ErrorTextStyle
            / TimeCheckBoxStyle / RateGroupStyle) have been promoted into
            Themes/WinMetersTheme.xaml as theme-level WinMeters* styles
            (WinMetersSectionHeader / WinMetersSliderLabel /
            WinMetersSlider / WinMetersRateTextBox / WinMetersRateLabel /
            WinMetersErrorText / WinMetersTimeCheckBox / WinMetersRateGroup).
            The Window.Resources block is now empty: future windows opt in
            via StaticResource references directly. No per-window shim
            layer remains.
        -->
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4,0,0,20">
                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource WinMetersSectionHeader}"/>
                <WrapPanel Margin="0,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Opacity:" Style="{StaticResource WinMetersSliderLabel}" Width="45"/>                                                <Slider x:Name="SliderOpacity" Minimum="0" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Style="{StaticResource WinMetersSlider}" TabIndex="0"/>
                        <TextBlock x:Name="TxtOpacity" Width="44" Margin="4,0" FontSize="10" TextAlignment="Left" Text="100%"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="Scale:" Style="{StaticResource WinMetersSliderLabel}" Width="35"/>                                                <Slider x:Name="SliderScale" Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Style="{StaticResource WinMetersSlider}" TabIndex="1"/>
                        <TextBlock x:Name="TxtScale" Width="44" Margin="4,0" FontSize="10" TextAlignment="Left" Text="1.0×"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Thin horizontal divider (1px top border on a Border with no
                     background). Opacity="0.22" on the dims the white
                     ThemeTextBrush into a subtle hairline that's visible on
                     the dark dialog chrome without competing with the section
                     headers above/below. BorderThickness=0,1,0,0 is the DPI-
                     safe way to draw a 1px line — a <Rectangle Height="1">
                     would round to whatever pixel-snapping rule the local
                     render tier enforces (could collapse to 0px on 175%
                     DPI). The same shape repeats below between every
                     consecutive pair of sections; see the bottom of this file
                     for a "between every section" rationale. -->
                <Border BorderBrush="{DynamicResource ThemeTextBrush}"
                        BorderThickness="0,1,0,0"
                        Opacity="0.22"
                        Margin="0,10,0,10"/>

                <!-- Refresh Rates -->
                <TextBlock Text="Refresh Rates (ms)" Style="{StaticResource WinMetersSectionHeader}"/>
                <WrapPanel Margin="0,2">
                    <StackPanel Style="{StaticResource WinMetersRateGroup}">
                        <TextBlock Text="CPU:" Style="{StaticResource WinMetersRateLabel}"/>
                        <TextBox x:Name="TxtRateCpu" Style="{StaticResource WinMetersRateTextBox}" TabIndex="2"/>
                        <TextBlock x:Name="ErrRateCpu" Style="{StaticResource WinMetersErrorText}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource WinMetersRateGroup}">
                        <TextBlock Text="RAM:" Style="{StaticResource WinMetersRateLabel}"/>
                        <TextBox x:Name="TxtRateRam" Style="{StaticResource WinMetersRateTextBox}" TabIndex="3"/>
                        <TextBlock x:Name="ErrRateRam" Style="{StaticResource WinMetersErrorText}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource WinMetersRateGroup}">
                        <TextBlock Text="Disk:" Style="{StaticResource WinMetersRateLabel}"/>
                        <TextBox x:Name="TxtRateDisk" Style="{StaticResource WinMetersRateTextBox}" TabIndex="4"/>
                        <TextBlock x:Name="ErrRateDisk" Style="{StaticResource WinMetersErrorText}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource WinMetersRateGroup}">
                        <TextBlock Text="Net:" Style="{StaticResource WinMetersRateLabel}"/>
                        <TextBox x:Name="TxtRateNet" Style="{StaticResource WinMetersRateTextBox}" TabIndex="5"/>
                        <TextBlock x:Name="ErrRateNet" Style="{StaticResource WinMetersErrorText}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource WinMetersRateGroup}">
                        <TextBlock Text="CPU Temp/Use:" Style="{StaticResource WinMetersRateLabel}"/>
                        <TextBox x:Name="TxtRateCpuTemp" Style="{StaticResource WinMetersRateTextBox}" TabIndex="15"/>
                        <TextBlock x:Name="ErrRateCpuTemp" Style="{StaticResource WinMetersErrorText}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource WinMetersRateGroup}">
                        <TextBlock Text="GPU Temp/Use:" Style="{StaticResource WinMetersRateLabel}"/>
                        <TextBox x:Name="TxtRateGpuTemp" Style="{StaticResource WinMetersRateTextBox}" TabIndex="16"/>
                        <TextBlock x:Name="ErrRateGpuTemp" Style="{StaticResource WinMetersErrorText}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource WinMetersRateGroup}">
                        <TextBlock Text="VRAM:" Style="{StaticResource WinMetersRateLabel}"/>
                        <TextBox x:Name="TxtRateGpuDedicated" Style="{StaticResource WinMetersRateTextBox}" TabIndex="19"/>
                        <TextBlock x:Name="ErrRateGpuDedicated" Style="{StaticResource WinMetersErrorText}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource WinMetersRateGroup}">
                        <TextBlock Text="SRAM:" Style="{StaticResource WinMetersRateLabel}"/>
                        <TextBox x:Name="TxtRateGpuShared" Style="{StaticResource WinMetersRateTextBox}" TabIndex="20"/>
                        <TextBlock x:Name="ErrRateGpuShared" Style="{StaticResource WinMetersErrorText}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Section divider (same shape as above; see first occurrence). -->
                <Border BorderBrush="{DynamicResource ThemeTextBrush}"
                        BorderThickness="0,1,0,0"
                        Opacity="0.22"
                        Margin="0,10,0,10"/>

                <!-- Colors -->
                <TextBlock Text="Colors" Style="{StaticResource WinMetersSectionHeader}"/>
                <WrapPanel x:Name="ColorsPanel" Orientation="Horizontal" ItemHeight="28" ItemWidth="200"/>

                <!-- Section divider (same shape as above; see first occurrence). -->
                <Border BorderBrush="{DynamicResource ThemeTextBrush}"
                        BorderThickness="0,1,0,0"
                        Opacity="0.22"
                        Margin="0,10,0,10"/>

                <!-- Visibility -->
                <TextBlock Text="Visibility" Style="{StaticResource WinMetersSectionHeader}"/>
                <WrapPanel Margin="0,2">
                    <!-- Access behavior toggles (Lock Position / Hide in Fullscreen /
                         Snap to Taskbar / Keep on Top). These don't gate any meter's
                         visibility; they gate how the bar BEHAVES in the desktop
                         and shell (DragMove disabled by LockPosition, AppBarService
                         driven by HideInFullscreen+SnapToTaskbar, WPF Topmost +
                         EnforceZOrder timer driven by KeepOnTop). Drawn first in
                         the Visibility section so the user lands on behavior
                         settings before the meter on/off matrix below. TabIndex
                         28-31 places them after every other keyboard-focusable
                         control so the tab cycle doesn't accidentally land on a
                         destructive Reset before the user has explored the
                         visibility choices. -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <CheckBox x:Name="ChkLockPosition"      Content="  Lock Position"    Style="{StaticResource WinMetersCheckBox}" TabIndex="28"/>
                        <CheckBox x:Name="ChkHideInFullscreen"  Content="  Hide in Fullscreen" Style="{StaticResource WinMetersCheckBox}" TabIndex="29"/>
                        <CheckBox x:Name="ChkSnapToTaskbar"     Content="  Snap to Taskbar"  Style="{StaticResource WinMetersCheckBox}" TabIndex="30"/>
                        <CheckBox x:Name="ChkKeepOnTop"         Content="  Keep on Top"      Style="{StaticResource WinMetersCheckBox}" TabIndex="31"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <CheckBox x:Name="ChkCpu" Content="  CPU Cores" Style="{StaticResource WinMetersCheckBox}" TabIndex="6"/>
                        <CheckBox x:Name="ChkRam" Content="  RAM" Style="{StaticResource WinMetersCheckBox}" TabIndex="7"/>
                        <CheckBox x:Name="ChkGpuDedicated" Content="  VRAM" Style="{StaticResource WinMetersCheckBox}" TabIndex="22"/>
                        <CheckBox x:Name="ChkGpuShared" Content="  SRAM" Style="{StaticResource WinMetersCheckBox}" TabIndex="23"/>
                        <CheckBox x:Name="ChkDisk" Content="  Disk" Style="{StaticResource WinMetersCheckBox}" TabIndex="8"/>
                        <CheckBox x:Name="ChkNet" Content="  Net" Style="{StaticResource WinMetersCheckBox}" TabIndex="9"/>
                        <CheckBox x:Name="ChkTime" Content="  System Time" Style="{StaticResource WinMetersCheckBox}" TabIndex="24"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                         <CheckBox x:Name="ChkCpuTemp" Content="  CPU Temp/Use" Style="{StaticResource WinMetersCheckBox}" TabIndex="17"/>
                        <CheckBox x:Name="ChkGpuTemp" Content="  GPU Temp/Use" Style="{StaticResource WinMetersCheckBox}" TabIndex="18"/>
                        <CheckBox x:Name="ChkCombineCpu" Content="  Combine Logical Cores" Style="{StaticResource WinMetersCheckBox}" TabIndex="10"/>
                        <CheckBox x:Name="ChkTime24H" Content="24-Hour Time" Style="{StaticResource WinMetersTimeCheckBox}" VerticalAlignment="Center" TabIndex="25"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Section divider (same shape as above; see first occurrence). -->
                <Border BorderBrush="{DynamicResource ThemeTextBrush}"
                        BorderThickness="0,1,0,0"
                        Opacity="0.22"
                        Margin="0,10,0,10"/>

                <!-- Disk -->
                <TextBlock Text="Disk" Style="{StaticResource WinMetersSectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <!-- Explicit Foreground because the TextBlock has no
                         Style reference (the other section header + rate
                         label TextBlocks inherit white from the local
                         SectionHeaderStyle / RateLabelStyle / SliderLabelStyle
                         via the WPF property-inheritance chain, but those
                         styles also lack a Foreground setter, so they only
                         get white because WPF's default TextBlock style
                         doesn't override the inherited value either. This
                         TextBlock is set explicitly to be defensive in
                         case the WPF default style ever changes). -->
                    <TextBlock Text="Drive R/W:" FontSize="10" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Width="65" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <!-- ComboDisk + ComboNetwork target the canonical
                         WinMetersComboBox directly. Inline FontSize="10"
                         + Width override the theme FontSize=12 + no-
                         Width setters so they keep the same compact
                         look the previous ComboBoxStyle shim provided.
                         Any future theme brush update (accent recolour,
                         border thickness, padding) propagates to both
                         ComboBoxes automatically through the theme
                         Style reference. -->
                    <ComboBox x:Name="ComboDisk" Style="{StaticResource WinMetersComboBox}" FontSize="10" Width="120" TabIndex="11"/>
                </StackPanel>

                <!-- Section divider (same shape as above; see first occurrence). -->
                <Border BorderBrush="{DynamicResource ThemeTextBrush}"
                        BorderThickness="0,1,0,0"
                        Opacity="0.22"
                        Margin="0,10,0,10"/>

                <!-- Network -->
                <TextBlock Text="Network" Style="{StaticResource WinMetersSectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <!-- Explicit Foreground; see the Drive R/W: TextBlock
                         comment above for the rationale. -->
                    <TextBlock Text="Interface:" FontSize="10" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Width="65" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ComboNetwork" Style="{StaticResource WinMetersComboBox}" FontSize="10" Width="160" TabIndex="12"/>
                </StackPanel>

                <!-- Section divider (same shape as above; see first occurrence). -->
                <Border BorderBrush="{DynamicResource ThemeTextBrush}"
                        BorderThickness="0,1,0,0"
                        Opacity="0.22"
                        Margin="0,10,0,10"/>

                <!-- Hotkey -->
                <!--
                    Live status label updates on every TextChanged through TxtHotkey_TextChanged.
                    The label shows the parsed (mods, vk) tuple as hex so an operator can verify
                    the chord resolved cleanly without round-tripping through GetAsyncKeyState.
                    TabIndex keeps the hotkey box ahead of the order-ListBox / Reset button
                    (the latter is the destructive control, tabbed last by convention).
                -->
                <TextBlock Text="Hotkey" Style="{StaticResource WinMetersSectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <!--
                        Compact label matches the existing slider / rate-label widths so the
                        section reads as one visual unit (50px column). Inline FontSize=10
                        matches the TravelOf TextBoxes on this dialog for visual consistency.
                    -->
                    <TextBlock Text="Chord:" Width="40" Margin="0,3,4,0" VerticalAlignment="Center" FontSize="10"
                               Foreground="{DynamicResource ThemeTextBrush}"/>
                    <!--
                        TextBox inherits the dialog Foreground from the inherited
                        Application.Resources ThemeBg brush, so we only need to override
                        Background + BorderBrush for a chrome-coherent look on the dark
                        dialog. The theme WinMetersRateTextBox style is narrower than we
                        want for the chord itself (it's tuned for short numeric strings);
                        inline overrides keep the same pattern instead of adding a new
                        textbox style.
                    -->
                    <TextBox x:Name="TxtHotkey" Width="200" FontSize="10" TabIndex="26" VerticalContentAlignment="Center"
                             Background="{DynamicResource ThemeBgBrush}"
                             Foreground="{DynamicResource ThemeTextBrush}"
                             BorderBrush="{DynamicResource ThemeTextBrush}"/>
                    <!--
                        "Default" button — one-click path back to the canonical chord (currently
                        Ctrl+Alt+Shift+M, exposed as HotkeyService.DefaultHotkeyString) after a
                        RegisterFailed collision event. TabIndex=33 places it after the meter-order
                        list so the keyboard tab cycle still lands on the destructive global Reset
                        last. The ToolTip draws on ThemeTextBrush so the message stays readable on
                        the dark dialog chrome.
                    -->
                    <Button x:Name="BtnResetHotkey" Content="_Default" Margin="6,0,0,0" Padding="6,2"
                            Foreground="{DynamicResource ThemeTextBrush}"
                            Background="{DynamicResource ThemeBgBrush}"
                            BorderBrush="{DynamicResource ThemeTextBrush}"
                            Click="BtnResetHotkey_Click" TabIndex="33"
                            ToolTip="Restore the hotkey chord to its default value (Ctrl+Alt+Shift+M)"/>
                    <TextBlock x:Name="LblHotkeyStatus" Margin="6,3,0,0" VerticalAlignment="Center" FontSize="9"
                               Foreground="{DynamicResource ThemeTextBrush}"/>
                </StackPanel>

                <!-- Section divider (same shape as above; see first occurrence). -->
                <Border BorderBrush="{DynamicResource ThemeTextBrush}"
                        BorderThickness="0,1,0,0"
                        Opacity="0.22"
                        Margin="0,10,0,10"/>

                <!-- Meter Display Order -->
                <TextBlock Text="Meter Display Order" Style="{StaticResource WinMetersSectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Explicit Background because the ListBox has no Style
                         reference (no local ListBoxStyle exists). WPF's
                         default ListBox style pins Background to
                         SystemColors.Window (white), which would paint
                         the meter-order list as a bright stripe against
                         the dark dialog chrome. ThemeBgBrush makes it
                         blend in. The ItemContainerStyle points at the
                         theme-level WinMetersListBoxItem (defined in
                         Themes/WinMetersTheme.xaml next to the
                         WinMetersComboBoxItem precedent) so a future
                         window's ListBox can opt into the same themed
                         item paint with a single StaticResource ref
                         and no per-window code-behind helper.
                         WinMetersListBoxItem's resting Foreground is
                         ThemeTextBrush (so labels render white instead
                         of WPF's default SystemColors.ControlTextBrushKey
                         black) and the IsMouseOver + IsSelected triggers
                         paint Background=ThemeAccentBrush +
                         Foreground=ThemeTextBrush (the same
                         highlighted-row affordance the previous
                         CreateMenuListBoxItemStyle helper provided).
                    -->
                    <ListBox x:Name="ListMeterOrder" Height="100" Margin="0,0,4,0" DisplayMemberPath="Name"
                             Background="{DynamicResource ThemeBgBrush}"
                             ItemContainerStyle="{StaticResource WinMetersListBoxItem}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Explicit Foreground on the 2 meter-order arrow
                             buttons; same WPF-default-style override as the
                             3 footer buttons above. The Unicode arrows
                             (U+2191 / U+2193) would otherwise render black
                             on the dark chrome. -->
                        <Button x:Name="BtnMoveUp" Content="↑" Margin="2" Width="40" Foreground="{DynamicResource ThemeTextBrush}" Background="{DynamicResource ThemeBgBrush}" Click="BtnMoveUp_Click"/>
                        <Button x:Name="BtnMoveDown" Content="↓" Margin="2" Width="40" Foreground="{DynamicResource ThemeTextBrush}" Background="{DynamicResource ThemeBgBrush}" Click="BtnMoveDown_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <!-- Explicit Foreground on the 3 footer buttons because they
                 have no Style reference; WPF's default Button style pins
                 Foreground to SystemColors.ControlTextBrushKey (same
                 WPF-default-style override that hits the CheckBox
                 labels; see the CheckBoxStyle comment above for the
                 full precedence-chain explanation). The button label
                 text would otherwise paint black on the dark chrome. -->
            <Button x:Name="BtnReset" Content="_Reset to defaults" Width="100" Margin="6" Foreground="{DynamicResource ThemeTextBrush}" Background="{DynamicResource ThemeBgBrush}" Click="BtnReset_Click" TabIndex="27"/>
            <Button Width="90" Margin="6" Foreground="{DynamicResource ThemeTextBrush}" Background="{DynamicResource ThemeBgBrush}" Click="BtnOk_Click" IsDefault="True" TabIndex="13">_OK</Button>
            <Button Width="90" Margin="6" Foreground="{DynamicResource ThemeTextBrush}" Background="{DynamicResource ThemeBgBrush}" Click="BtnCancel_Click" IsCancel="True" TabIndex="14">_Cancel</Button>
        </StackPanel>
    </Grid>
</Window>