<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>2.5.2</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Avoid running the C# compiler during design-time builds for temp wpftmp projects -->
    <SkipCompilerExecutionForDesignTimeBuild>true</SkipCompilerExecutionForDesignTimeBuild>
    <!-- Application manifest: requires Administrator privileges so RegisterHotKey works in fullscreen games -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Application icon used for the compiled executable and taskbar/Alt-Tab -->
    <ApplicationIcon>winmeters.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Single-file safety: turn IL3xxx warnings (Assembly.Location,
         FileName, CodeBase, AssemblyName.CodeBase) into build errors so
         any future use of those properties (which return empty in
         single-file publishes) breaks the build instead of silently
         regressing. Scoped to Release because that's where
         PublishSingleFile is enabled; the IL3xxx warnings are N/A in
         Debug where single-file is off. -->
    <WarningsAsErrors>IL3000;IL3001;IL3002;IL3003</WarningsAsErrors>
  </PropertyGroup>

  <!-- Packages removed - included in .NET 10 by default -->

  <!-- Ensure Windows Forms integration is available at build and design time -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <!-- Icon assets:
       - winmeters.png is embedded as a WPF resource so window icons can load it
         from the assembly via pack URI, avoiding single-file publish copy issues.
       - winmeters.ico is copied to output/publish so the tray icon can load it. -->
  <ItemGroup>
    <None Remove="winmeters.png" />
    <Resource Include="winmeters.png" />
    <None Update="winmeters.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Exclude the test project sources from WinMeters (and its WPF design-time wpftmp variant)
       so build/publish never try to compile xunit-laced test files. The Tests\ project is a
       separate assembly referenced via Compile Include from the test csproj; WinMeters has
       no runtime dependency on anything under Tests\, so we drop them from the default
       **/*.cs glob. -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
  </ItemGroup>

  <!-- LibreHardwareMonitor for hardware sensor monitoring (NuGet package includes native drivers) -->
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

  <!--
    <Page Update> for the hand-built WinMeters theme, NOT <Page Include>.
    The SDK's <UseWPF>true</UseWPF> auto-default globs cover `**\*.xaml`
    so the file is already included as a Page item. <Page Include> would
    collide with the auto-included one and trigger NETSDK1022. <Page
    Update> adds explicit generator metadata to the existing item
    without creating a duplicate. This guarantees the .xaml is compiled
    to BAML by MSBuild:Compile with the Wpf XAML runtime, regardless
    of any default-glob corner cases under <PublishSingleFile> source
    permutations.
  -->
  <ItemGroup>
    <Page Update="Themes\WinMetersTheme.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- During design-time builds include a lightweight logging shim and exclude heavy logging implementation so temp builds succeed -->
  <PropertyGroup Condition=" '$(DesignTimeBuild)' == 'true' Or '$(BuildingInsideVisualStudio)' == 'true' ">
    <DefineConstants>$(DefineConstants);DESIGN_TIME</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition=" '$(DesignTimeBuild)' == 'true' Or '$(BuildingInsideVisualStudio)' == 'true' ">
    <Compile Include="Logging\DesignTimeLoggingShim.cs" />
    <!-- Exclude the complex runtime logging sources to avoid type conflicts in wpftmp projects -->
    <Compile Remove="Logging\LogManager.cs" />
    <Compile Remove="Logging\FileLogger.cs" />
    <Compile Include="Logging\DesignTimeLogManager.cs" />

    <!-- Ensure Windows Forms integration is available in design-time temp projects so generated g.cs can compile -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />

    <!-- Exclude WPF windows from design-time builds to avoid duplicate generated members in wpftmp (keep App.xaml for an entry point) -->
    <Page Remove="MainWindow.xaml" />
    <Page Remove="SettingsWindow.xaml" />
    <Page Remove="App.xaml" />

    <Compile Include="Logging\DesignTimeAppStub.cs" />

    <!-- Note: logging removed and design-time shim files neutralized -->
  </ItemGroup>

  <!-- Build-time guard against the MSB4025 XML-comment trap. A
       double-hyphen sequence inside an XML comment is illegal in
       both the Wpf XAML compiler and MSBuild's own project-file
       parser, and the resulting error is cryptic ("An XML comment
       cannot contain double-hyphen"). The Check-XmlComments.ps1
       script scans every .xaml / .csproj / .props / .targets for
       the pattern and fails the build with a clear, file:line
       error if it finds one. Runs before CoreCompile so the script
       catches the issue before the Wpf XAML compiler can. Skip on
       design-time builds (temp wpftmp projects have a stripped
       XAML set). Opt out for a single build with
       -p:DisableXmlCommentCheck=true. -->
  <Target Name="CheckXmlComments"
          BeforeTargets="CoreCompile"
          Condition="'$(DisableXmlCommentCheck)' != 'true' AND '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Check-XmlComments.ps1&quot; -Path &quot;$(MSBuildThisFileDirectory)&quot;"
          ContinueOnError="false" />
  </Target>

  <!-- Regenerate the application icon from the source PNG whenever the PNG changes.
       Runs before the build so the ICO is up-to-date before ApplicationIcon is embedded.
       Skipped during design-time builds to avoid spawning PowerShell in Visual Studio. -->
  <Target Name="GenerateIcoFromPng"
          BeforeTargets="BeforeBuild"
          Inputs="$(MSBuildThisFileDirectory)winmeters.png"
          Outputs="$(MSBuildThisFileDirectory)winmeters.ico"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Convert-PngToIco.ps1&quot; -PngPath &quot;$(MSBuildThisFileDirectory)winmeters.png&quot; -IcoPath &quot;$(MSBuildThisFileDirectory)winmeters.ico&quot;"
          ContinueOnError="false" />
  </Target>

</Project>
