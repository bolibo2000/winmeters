<UserControl x:Class="WinMeters.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="100"
             x:Name="Root">
    <Border Style="{StaticResource WinMetersCard}"
            Margin="0,0,0,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title row: glyph + title + Show toggle -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Text="{Binding ElementName=Root, Path=Glyph}"
                           Foreground="{DynamicResource ThemeAccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource WinMetersTextHeading}"
                               Text="{Binding ElementName=Root, Path=Title}"
                               FontSize="15"/>
                    <TextBlock Style="{StaticResource WinMetersTextSub}"
                               Text="{Binding ElementName=Root, Path=Subtitle}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource WinMetersTextHint}"
                               Text="Show"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <CheckBox IsChecked="{Binding ElementName=Root, Path=IsShown, Mode=TwoWay}"
                              Style="{StaticResource WinMetersToggleSwitch}"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 2-control row: section color (with swatch + pick), refresh rate.
                 The Max-value column was removed in the same commit per user
                 request (the data model stays intact on AppSettings.MaxValues
                 so any future consumer-side wiring can drop in without
                 touching settings.json), but the on-card UI affordance and
                 its DP / validation / event handler were deleted because
                 there is no current rendering consumer that reads them. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Section color -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Swatch" Width="22" Height="22"
                            CornerRadius="3" BorderBrush="White" BorderThickness="1"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Section colour..."
                            Click="ColorButton_Click"
                            ToolTip="Override this meter's section color in the bar"
                            Style="{StaticResource WinMetersSecondaryButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"/>
                </Grid>

                <!-- Refresh rate -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource WinMetersTextHint}"
                               Text="Refresh rate (ms)"
                               Margin="0,0,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtRate" Grid.Column="0"
                                 Style="{StaticResource WinMetersTextBox}"
                                 Text="{Binding ElementName=Root, Path=RefreshRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock x:Name="ErrRate" Grid.Column="1"
                                   Style="{StaticResource WinMetersTextSub}"
                                   Foreground="{DynamicResource ThemeDangerBrush}"
                                   Visibility="Collapsed"
                                   FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
