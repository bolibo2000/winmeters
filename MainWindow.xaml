<Window x:Class="WinMeters.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinMeters"
        mc:Ignorable="d"
        Title="WinMeters" Height="40" Width="Auto" SizeToContent="Width"
        Icon="pack://application:,,,/winmeters.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <!--
            Bar meter styles (Label / Value / MetricValue / Icon / PieLabel /
            GridRow) live in Themes/WinMetersTheme.xaml so any future window
            can reuse them. The implicit StackPanel style below stays here
            because it governs tooltip placement behaviour specific to the
            bar's per-meter panels.
        -->
        <Style TargetType="StackPanel">
            <!-- Anchor tooltips above each panel regardless of bar position. -->
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <Setter Property="ToolTipService.VerticalOffset" Value="0"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="1000"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="500"/>
        </Style>
        <!-- Arrow Paths -->
        <PathGeometry x:Key="ArrowDownGeometry">
            <PathFigure StartPoint="3,6">
                <LineSegment Point="7,14"/>
                <LineSegment Point="11,6"/>
                <LineSegment Point="8.5,6"/>
                <LineSegment Point="8.5,0"/>
                <LineSegment Point="5.5,0"/>
                <LineSegment Point="5.5,6"/>
                <LineSegment Point="3,6"/>
            </PathFigure>
        </PathGeometry>
        <PathGeometry x:Key="ArrowUpGeometry">
            <PathFigure StartPoint="3,8">
                <LineSegment Point="7,0"/>
                <LineSegment Point="11,8"/>
                <LineSegment Point="8.5,8"/>
                <LineSegment Point="8.5,14"/>
                <LineSegment Point="5.5,14"/>
                <LineSegment Point="5.5,8"/>
                <LineSegment Point="3,8"/>
            </PathFigure>
        </PathGeometry>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Border x:Name="MainBorder" Background="{DynamicResource ThemeBarBgBrush}" CornerRadius="5" BorderBrush="{DynamicResource ThemeBarBorderBrush}" BorderThickness="0">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="MainScale" ScaleX="1.0" ScaleY="1.0"/>
            </Border.LayoutTransform>
            <StackPanel Orientation="Horizontal" Margin="5,0">

                <!-- CPU Usage -->
                <StackPanel x:Name="PanelCpu" Orientation="Horizontal">
                    <StackPanel x:Name="CpuContainer" Orientation="Horizontal" Height="24" Margin="5,5,0,5" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Hardware Temps -->
                <StackPanel x:Name="PanelHardware" Orientation="Vertical" Margin="0,5" VerticalAlignment="Center" Width="90">
                    <Grid x:Name="RowCpuTemp" Style="{StaticResource WinMetersBarGridRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CpuTempLabel" Grid.Column="0" Text="Cpu:" Style="{StaticResource WinMetersBarLabel}"/>
                        <TextBlock x:Name="CpuTempText" Grid.Column="1" Text="--°C" Style="{StaticResource WinMetersBarMetricValue}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="CpuLoadText" Grid.Column="2" Text="--%" Style="{StaticResource WinMetersBarMetricValue}" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    </Grid>
                    <Grid x:Name="RowGpuTemp" Style="{StaticResource WinMetersBarGridRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GpuTempLabel" Grid.Column="0" Text="Gpu:" Style="{StaticResource WinMetersBarLabel}"/>
                        <TextBlock x:Name="GpuTempText" Grid.Column="1" Text="--°C" Foreground="{DynamicResource ThemeMetricGpuBrush}" Style="{StaticResource WinMetersBarMetricValue}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="GpuLoadText" Grid.Column="2" Text="--%" Foreground="{DynamicResource ThemeMetricGpuBrush}" Style="{StaticResource WinMetersBarMetricValue}" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    </Grid>
                </StackPanel>

                <!-- RAM -->
                <StackPanel x:Name="PanelRam" Orientation="Horizontal">
                    <Grid Width="24" Height="24" Margin="4,0" VerticalAlignment="Center">
                        <Image x:Name="RamPie" Width="24" Height="24" Stretch="Uniform"/>
                        <TextBlock x:Name="RamLabel" Text="RAM" Style="{StaticResource WinMetersBarPieLabel}"/>
                    </Grid>
                </StackPanel>

                <!-- GPU Dedicated Memory -->
                <StackPanel x:Name="PanelGpuDedicated" Orientation="Horizontal">
                    <Grid Width="24" Height="24" Margin="4,0" VerticalAlignment="Center">
                        <Image x:Name="GpuDedicatedPie" Width="24" Height="24" Stretch="Uniform"/>
                        <TextBlock x:Name="GpuDedicatedLabel" Text="VRAM" Style="{StaticResource WinMetersBarPieLabel}"/>
                    </Grid>
                </StackPanel>

                <!-- GPU Shared Memory -->
                <StackPanel x:Name="PanelGpuShared" Orientation="Horizontal">
                    <Grid Width="24" Height="24" Margin="4,0" VerticalAlignment="Center">
                        <Image x:Name="GpuSharedPie" Width="24" Height="24" Stretch="Uniform"/>
                        <TextBlock x:Name="GpuSharedLabel" Text="SRAM" Style="{StaticResource WinMetersBarPieLabel}"/>
                    </Grid>
                </StackPanel>

                <!-- DISK -->
                <StackPanel x:Name="PanelDisk" Orientation="Vertical" Margin="0,5" VerticalAlignment="Center" Width="60">
                    <Grid Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R:" x:Name="DiskRestText" Foreground="{DynamicResource ThemeDiskReadBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,4,0" Width="15"/>
                        <TextBlock Grid.Column="1" x:Name="DiskReadText" Text="0%" Style="{StaticResource WinMetersBarValue}"/>
                    </Grid>
                    <Grid Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="W:" x:Name="DiskWriteLabel" Foreground="{DynamicResource ThemeDiskWriteBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,4,0" Width="15"/>
                        <TextBlock Grid.Column="1" x:Name="DiskWriteText" Text="0%" Style="{StaticResource WinMetersBarValue}"/>
                    </Grid>
                </StackPanel>

                <!-- NET -->
                <StackPanel x:Name="PanelNet" Orientation="Vertical" Margin="0,5" VerticalAlignment="Center" Width="83">
                    <Grid Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ArrowDown" Grid.Column="0" Data="{StaticResource ArrowDownGeometry}" Style="{StaticResource WinMetersBarIcon}" VerticalAlignment="Center" Margin="0,1,4,0"/>
                        <TextBlock Grid.Column="1" x:Name="NetDownText" Text="0 KB/s" Style="{StaticResource WinMetersBarValue}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ArrowUp" Grid.Column="0" Data="{StaticResource ArrowUpGeometry}" Style="{StaticResource WinMetersBarIcon}" VerticalAlignment="Center" Margin="0,0,4,1"/>
                        <TextBlock Grid.Column="1" x:Name="NetUpText" Text="0 KB/s" Style="{StaticResource WinMetersBarValue}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- Time -->
                <StackPanel x:Name="PanelTime" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                    <TextBlock x:Name="TimeText" Text="00:00" Style="{StaticResource WinMetersBarValue}" FontSize="11" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
