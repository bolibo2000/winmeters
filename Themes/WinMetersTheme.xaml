<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme token brushes -->
    <SolidColorBrush x:Key="ThemeBgBrush"          Color="#1F1F1F"/>
    <SolidColorBrush x:Key="ThemeCardBgBrush"      Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ThemeCardBorderBrush"  Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ThemeAccentBrush"      Color="#00CCFF"/>
    <SolidColorBrush x:Key="ThemeAccentDimBrush"   Color="#3300CCFF"/>
    <SolidColorBrush x:Key="ThemeTextBrush"        Color="White"/>

    <!-- Bar token brushes (MainWindow.xaml) -->
    <SolidColorBrush x:Key="ThemeBarBgBrush"             Color="#CC202020"/>
    <SolidColorBrush x:Key="ThemeBarBorderBrush"         Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="ThemeLabelBrush"             Color="#AAAAAA"/>
    <SolidColorBrush x:Key="ThemeMetricCpuBrush"         Color="#FF6B6B"/>
    <SolidColorBrush x:Key="ThemeMetricGpuBrush"         Color="#4ECDC4"/>
    <SolidColorBrush x:Key="ThemeDiskReadBrush"          Color="#44FF44"/>
    <SolidColorBrush x:Key="ThemeDiskWriteBrush"         Color="#FF4444"/>
    <SolidColorBrush x:Key="ThemeErrorBrush"             Color="Red"/>
    <SolidColorBrush x:Key="ThemeBarTooltipBgBrush"      Color="#FF202020"/>
    <SolidColorBrush x:Key="ThemeBarTooltipBorderBrush"  Color="#55555555"/>

    <!-- Bar meter styles (MainWindow.xaml) -->
    <Style x:Key="WinMetersBarLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeLabelBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="WinMetersBarValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="WinMetersBarMetricValue" TargetType="TextBlock" BasedOn="{StaticResource WinMetersBarValue}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMetricCpuBrush}"/>
    </Style>

    <Style x:Key="WinMetersBarIcon" TargetType="Path">
        <Setter Property="Fill" Value="{DynamicResource ThemeLabelBrush}"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <Style x:Key="WinMetersBarPieLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="1" ShadowDepth="1" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinMetersBarGridRow" TargetType="Grid">
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <!-- Base text style for headings/labels -->
    <Style x:Key="WinMetersTextHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
    </Style>

    <!-- CheckBox template: white checkmark on dark chrome, accent border on hover -->
    <ControlTemplate x:Key="WinMetersCheckBoxTemplate" TargetType="{x:Type CheckBox}">
        <BulletDecorator Background="Transparent">
            <BulletDecorator.Bullet>
                <Grid Width="13" Height="13">
                    <Border x:Name="OuterBorder"
                        BorderThickness="1"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"/>
                    <Path x:Name="CheckMark"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="2"
                        Data="M 0,5 L 2,7 L 7,0"
                        Stretch="None"
                        Visibility="Collapsed"
                        RenderOptions.EdgeMode="Aliased"/>
                    <Path x:Name="InderminateMark"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="2"
                        Data="M 0,0 L 7,0"
                        Stretch="None"
                        Visibility="Collapsed"
                        RenderOptions.EdgeMode="Aliased"/>
                </Grid>
            </BulletDecorator.Bullet>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              RecognizesAccessKey="True"/>
        </BulletDecorator>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="InderminateMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="OuterBorder" Property="BorderBrush"
                        Value="{DynamicResource ThemeAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="WinMetersCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
        <Setter Property="Template" Value="{StaticResource WinMetersCheckBoxTemplate}"/>
    </Style>

    <!-- ComboBox template: themed dropdown replacing Aero2 defaults -->
    <ControlTemplate x:Key="WinMetersComboBoxTemplate" TargetType="{x:Type ComboBox}">
        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ContentBorder"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
            </Border>

            <ToggleButton x:Name="PART_ToggleButton"
                          Grid.Column="1"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ArrowBorder"
                                Background="Transparent"
                                CornerRadius="0,4,4,0">
                            <Path x:Name="Arrow"
                                  Data="M 0,0 L 4,4 L 8,0 Z"
                                  Fill="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="0,2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowBorder" Property="Background" Value="{DynamicResource ThemeAccentDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="Fade"
                   Focusable="False">
                <Border x:Name="DropDownBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,4,0,0"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                    <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="WinMetersComboBoxItem" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Margin="2,0">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinMetersComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource WinMetersComboBoxItem}"/>
        <Setter Property="Template" Value="{StaticResource WinMetersComboBoxTemplate}"/>
    </Style>

    <!-- TextBox: dark surface, accent caret -->
    <Style x:Key="WinMetersTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccentDimBrush}"/>
    </Style>

    <!-- ListBoxItem: themed hover/select for dialog lists -->
    <Style x:Key="WinMetersListBoxItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Settings dialog input styles ===== -->

    <Style x:Key="WinMetersSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource WinMetersTextHeading}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,6,0,6"/>
        <Setter Property="Foreground" Value="#FF0080FF"/>
    </Style>

    <Style x:Key="WinMetersSliderLabel" TargetType="TextBlock" BasedOn="{StaticResource WinMetersTextHeading}">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="WinMetersRateLabel" TargetType="TextBlock" BasedOn="{StaticResource WinMetersTextHeading}">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="70"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,4,2"/>
    </Style>

    <Style x:Key="WinMetersErrorText" TargetType="TextBlock" BasedOn="{StaticResource WinMetersTextHeading}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeErrorBrush}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Margin" Value="0,-2,0,0"/>
    </Style>

    <Style x:Key="WinMetersRateTextBox" TargetType="TextBox" BasedOn="{StaticResource WinMetersTextBox}">
        <Setter Property="Width" Value="50"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
    </Style>

    <Style x:Key="WinMetersSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
    </Style>

    <Style x:Key="WinMetersTimeCheckBox" TargetType="CheckBox" BasedOn="{StaticResource WinMetersCheckBox}">
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="WinMetersRateGroup" TargetType="StackPanel">
        <Setter Property="Width" Value="130"/>
        <Setter Property="Margin" Value="2"/>
    </Style>

    <!-- Default ToolTip style -->
    <Style TargetType="ToolTip">
        <Setter Property="Background"     Value="{DynamicResource ThemeBarTooltipBgBrush}"/>
        <Setter Property="Foreground"     Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="BorderBrush"    Value="{DynamicResource ThemeBarTooltipBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"        Value="8,4"/>
        <Setter Property="FontFamily"     Value="Segoe UI"/>
        <Setter Property="FontSize"       Value="11"/>
        <Setter Property="FontWeight"     Value="Bold"/>
        <Setter Property="HasDropShadow"  Value="True"/>
        <Setter Property="Placement"      Value="MousePoint"/>
    </Style>

    <!-- Thin collapsible scrollbar -->
    <Style x:Key="WinMetersScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource ThemeAccentBrush}" CornerRadius="4" Margin="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinMetersScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinMetersScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="GridRoot" Width="8" Background="{TemplateBinding Background}">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource WinMetersScrollBarPageButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource WinMetersScrollBarPageButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource WinMetersScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="0.4" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="GridRoot" Height="8" Background="{TemplateBinding Background}">
                                <Track Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource WinMetersScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource WinMetersScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource WinMetersScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource WinMetersScrollBar}"/>

</ResourceDictionary>
