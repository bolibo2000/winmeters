<Window x:Class="WinMeters.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WinMeters" Width="440" Icon="pack://application:,,,/winmeters.png"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand: large "WinMeters" wordmark. Foreground inherits from
             Window.Foreground (ColorHelper.GetMenuTextBrush), so it picks
             up the OS-painted COLOR_MENUTEXT color live. FontSize 24 makes
             it sans-serif big-text weight ~600; matches Kil0bit .WM.old
             About-window styling. -->
        <TextBlock Grid.Row="0" x:Name="TxtBrand"
                   Text="WinMeters"
                   FontSize="24" FontWeight="SemiBold"
                   Foreground="#FF0080FF"
                   Margin="0,4,0,0"/>

        <!-- Tagline: complements the brand. -->
        <TextBlock Grid.Row="1" x:Name="TxtTagline"
                   FontSize="11" Margin="0,2,0,12">
            <Run Text="A slim system-monitor overlay for the Windows taskbar." />
            <LineBreak/>
            <Run Text="Based on XMeters." />
        </TextBlock>

        <!-- Version + Build row: side-by-side label/value pair. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2">
            <TextBlock Text="Version:" FontSize="11" Width="70" />
            <TextBlock x:Name="TxtVersion" Text="—" FontSize="11" />
        </StackPanel>

        <!-- .NET target framework row (so users can see at a glance which
             runtime they need). Filled by code-behind from the assembly's
             TargetFrameworkAttribute so it stays in lockstep with the
             csproj's <TargetFramework>. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2">
            <TextBlock Text="Runtime:" FontSize="11" Width="70" />
            <TextBlock x:Name="TxtRuntime" Text="—" FontSize="11" />
        </StackPanel>

        <!-- Features: bullet-list summary of the bar's headline capabilities.
             Sits in Row 4 (the slot previously reserved for an excerpt /
             credits panel still being designed). The Ctrl+Alt+Shift+M chord
             matches the hotkey owned by Services/HotkeyService and bound
             to MainWindow.ToggleVisibility. -->
        <TextBlock Grid.Row="4" x:Name="TxtFeatures" FontSize="11" Margin="0,2">
            <LineBreak/>
            <Run Text="Features:" FontWeight="SemiBold"/>
            <LineBreak/>
            <Run Text="  • CPU &amp; RAM monitoring"/>
            <LineBreak/>
            <Run Text="  • Multi-GPU VRAM &amp; SRAM tracking"/>
            <LineBreak/>
            <Run Text="  • Disk &amp; Network activity monitoring"/>
            <LineBreak/>
            <Run Text="  • Hardware temperatures monitoring"/>
            <LineBreak/>
        </TextBlock>

        <!-- Hotkey hint: replaced the prior hardcoded "Ctrl+Alt+Shift+M" Run with a
             code-behind-bound TextBlock so the About window always reflects the user's
             actual saved chord from Settings \u2192 AppSettings.General.Hotkey, never a stale
             default that drifted from HotkeyService. -->
        <TextBlock Grid.Row="5" x:Name="TxtHotkey" FontSize="11" FontWeight="SemiBold" Margin="0,2"/>

        <!-- OK button: right-aligned at bottom (matches Windows About
             dialog convention). IsDefault=True so Enter closes the
             dialog. TabIndex=1 so Tab cycles straight to OK without
             stalling on any of the read-only TextBlocks. -->
        <Button Grid.Row="6" x:Name="BtnOk"
                Content="_OK" Width="90" Margin="0,8,0,0"
                HorizontalAlignment="Right"
                IsDefault="True" Click="BtnOk_Click"
                TabIndex="1"/>
    </Grid>
</Window>
